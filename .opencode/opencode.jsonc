{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "developer": {
      "prompt": "{file:.claude/agents/developer.md}"
    },
    "architect": {
      "prompt": "{file:.claude/agents/architect.md}"
    },
    "security-reviewer": {
      "prompt": "{file:.claude/agents/security-reviewer.md}"
    },
    "code-reviewer": {
      "prompt": "{file:.claude/agents/code-reviewer.md}"
    },
    "threat-modeler": {
      "prompt": "{file:.claude/agents/threat-modeler.md}"
    },
    "devils-advocate": {
      "prompt": "{file:.claude/agents/devils-advocate.md}"
    }
  },
  "permission": {
    "bash": "deny",
    "edit": "allow"
  },
  "experimental": {
    "policies": [
      // Broad allows first
      { "effect": "allow", "action": "bash.run", "resource": "git *" },
      { "effect": "allow", "action": "bash.run", "resource": "gh pr *" },
      { "effect": "allow", "action": "bash.run", "resource": "gh api *" },
      { "effect": "allow", "action": "bash.run", "resource": "npx jest*" },
      { "effect": "allow", "action": "bash.run", "resource": "npx tsx*" },
      { "effect": "allow", "action": "bash.run", "resource": "npx tsc*" },
      { "effect": "allow", "action": "bash.run", "resource": "node *" },
      { "effect": "allow", "action": "bash.run", "resource": "awk *" },
      { "effect": "allow", "action": "bash.run", "resource": "sort*" },
      { "effect": "allow", "action": "bash.run", "resource": "ls*" },
      { "effect": "allow", "action": "bash.run", "resource": "cat*" },
      { "effect": "allow", "action": "bash.run", "resource": "wc*" },
      { "effect": "allow", "action": "bash.run", "resource": "find*" },
      { "effect": "allow", "action": "bash.run", "resource": "grep*" },
      // Specific denies last — override broad git allow
      { "effect": "deny", "action": "bash.run", "resource": "git commit*" },
      { "effect": "deny", "action": "bash.run", "resource": "git merge*" },
      { "effect": "deny", "action": "bash.run", "resource": "git push*" }
    ]
  }
}